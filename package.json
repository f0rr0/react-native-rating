{
  "name": "react-native-rating",
  "version": "3.0.0",
  "description": "A small, accessible rating input for modern React Native.",
  "keywords": [
    "accessibility",
    "android",
    "component",
    "ios",
    "rating",
    "react-native",
    "stars"
  ],
  "homepage": "https://github.com/f0rr0/react-native-rating#readme",
  "bugs": {
    "url": "https://github.com/f0rr0/react-native-rating/issues"
  },
  "license": "MIT",
  "author": "Siddharth Jain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f0rr0/react-native-rating.git"
  },
  "files": [
    "lib",
    "src",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-rating-source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bob build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run package:check",
    "fix": "ultracite fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "package:check": "bun run build && publint --strict && attw --pack",
    "prepare": "bun run build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@jest/globals": "29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "jest": "29.7.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.22",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-builder-bob": "0.43.0",
    "test-renderer": "1.2.0",
    "typescript": "7.0.2",
    "ultracite": "7.9.4"
  },
  "peerDependencies": {
    "react": ">=19.1.1",
    "react-native": ">=0.82.0"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-rating-source"
      ]
    }
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "bun@1.3.14",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
